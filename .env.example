# 服务端默认使用的 OpenAI 兼容模型；网页中的 API 配置可以覆盖这些值。
# API Key 留空时，也可使用 DEEPSEEK_API_KEY、OPENAI_API_KEY 或 DASHSCOPE_API_KEY。
PRISM_LLM_API_KEY=
# 留空时使用 DeepSeek 默认地址；其他服务填写服务商提供的 Base URL。
PRISM_LLM_BASE_URL=
# 留空时使用 deepseek-v4-flash。
PRISM_LLM_MODEL=

# 服务端访问扶摇金融数据服务使用的密钥，不得发送到浏览器。
HITHINK_FINANCE_API_KEY=
# 可选项；默认服务地址为 https://fuyao.aicubes.cn。
HITHINK_FINANCE_BASE_URL=https://fuyao.aicubes.cn

# Yahoo Finance 的非官方 Chart 接口无需账户或 API Key。
# 以下代码可以调整；默认分别为 ^TNX、BZ=F 和 GC=F。
YAHOO_US10Y_SYMBOL=^TNX
YAHOO_BRENT_SYMBOL=BZ=F
YAHOO_GOLD_SYMBOL=GC=F

# 旧版 iFinD 测试配置；普通本地使用无需填写。
IFIND_QUANT_REFRESH_TOKEN=

# 问财服务端配置。IWENCAI_* 是官方 OpenAPI 变量名称。
# WENCAI_SKILLHUB_* 变量名称也受支持。
IWENCAI_BASE_URL=https://openapi.iwencai.com
IWENCAI_API_KEY=
# 真实接口检查完成后，部署人员才可以设置为 true。
# Windows 桌面版会通过 DPAPI 保存已确认的状态。
WENCAI_SKILLHUB_CONTRACT_VERIFIED=false

# 正常启动会启用本地账户和服务端会话。
# 可选文件仅用于一次性导入旧版 HTTP Basic 账户。
PRISM_AUTH_ACCOUNTS_FILE=
# 开发或本机演示时可关闭登录检查；多人共用的主机请保持 false。
PRISM_DEV_NO_AUTH=false
# 本地 SQLite 文件位置；默认使用 data/private/prism.sqlite3。
PRISM_DB_PATH=
# 可选 PostgreSQL 连接地址；填写后会优先使用 PostgreSQL。
# 连接地址可能含有密码，请勿提交到 Git。
PRISM_DATABASE_URL=

# 单进程研究任务默认限额：任务100、队列400、用户队列200、总预算60秒。
# 数据服务和模型服务的并发上限互相独立，也不代表服务商的实际容量。
PRISM_RESEARCH_PROVIDER_LIMIT=100
PRISM_RESEARCH_MODEL_LIMIT=8

# 可选的 Windows DPAPI 加密密钥文件位置；默认使用
# data/private/prism-secrets.json，文件只保存密文。
PRISM_SECRET_STORE_PATH=
