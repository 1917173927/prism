# Server-side external financial data provider. Never expose this value to browsers.
HITHINK_FINANCE_API_KEY=
# Optional override; the default is https://fuyao.aicubes.cn
HITHINK_FINANCE_BASE_URL=https://fuyao.aicubes.cn

# Yahoo Finance's unofficial Chart endpoint needs no account or API key.
# These overrides are optional; the provider defaults to ^TNX, BZ=F and GC=F.
YAHOO_US10Y_SYMBOL=^TNX
YAHOO_BRENT_SYMBOL=BZ=F
YAHOO_GOLD_SYMBOL=GC=F

# Legacy iFinD variable retained only for older injected-provider tests.
IFIND_QUANT_REFRESH_TOKEN=

# Optional server-side Wencai SkillHub credentials. IWENCAI_* is the official
# OpenAPI naming; WENCAI_SKILLHUB_* remains supported for compatibility.
IWENCAI_BASE_URL=https://openapi.iwencai.com
IWENCAI_API_KEY=
# Environment deployments may set this only after completing a real contract
# probe. Windows desktop deployments persist the verified state with DPAPI.
WENCAI_SKILLHUB_CONTRACT_VERIFIED=false

# Normal startup enables database-backed local accounts and server sessions.
# This optional file is read only to import legacy HTTP Basic accounts once.
PRISM_AUTH_ACCOUNTS_FILE=
# Explicit unauthenticated development/demo mode. Never enable on a shared host.
PRISM_DEV_NO_AUTH=false
# Local SQLite path; defaults to data/private/prism.sqlite3.
PRISM_DB_PATH=
# Optional PostgreSQL DSN; when set, takes precedence over SQLite. Never committed with credentials.
PRISM_DATABASE_URL=

# Optional Windows DPAPI-protected owner credential registry. The default is
# data/private/prism-secrets.json and the file contains ciphertext only.
PRISM_SECRET_STORE_PATH=
