flowchart TD
  entry(["浏览器工作台 · 页面入口<br/>index.html / Hash 路由"]) --> view
  subgraph view[01  用户交互]
    direction LR
    chat["AI 对话<br/>消息与工具进度"]
    account["画像与持仓<br/>问卷 · 导入 · 确认"]
    report["分析报告<br/>风险 · 配置 · 行情"]
    chat ~~~ account ~~~ report
  end
  view --> state["app.js · 状态与事件协调<br/>用户归属 · 画像 · 持仓"]
  subgraph interaction[02  状态保存与服务通信]
    direction LR
    history["会话消息<br/>账户隔离 · 最近消息"]
    api["请求与流式处理<br/>fetch / HTTP / SSE"]
  end
  state --> history
  state --> api
  api --> backend["FastAPI 接口<br/>结构化响应 · 状态 · 引用"]
  subgraph presentation[03  结果呈现]
    render["展示组件<br/>Markdown · 图表<br/>工作流视图"]
  end
  state -.->|本地状态更新| presentation
  backend -->|响应与事件| presentation
