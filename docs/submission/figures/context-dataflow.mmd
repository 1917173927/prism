flowchart TD
  subgraph inputs[01  用户输入与资料]
    direction LR
    user["当前问题<br/>用户输入与追问"]
    saved[("历史记录<br/>显式保存与检索")]
    profile["当前画像与持仓<br/>用户选择 · 更新 · 确认"]
    user ~~~ saved
    saved --> profile
  end
  inputs --> entry["请求入口 · 前提处理<br/>有绑定：核验版本与事实<br/>无绑定：清除个性化资料"]
  entry -->|核验失败| confirm(["提示重新确认"])
  entry -->|核验通过或未绑定| route["消息构建与工具需求判定<br/>历史消息最多 6 条"]
  subgraph processing[02  按需求处理]
    direction LR
    general["一般交流<br/>概念解释与一般回答"]
    market["金融资料查询<br/>允许无个人前提查询"]
    personal["个人组合问题<br/>持仓体检或调仓工具"]
  end
  route --> general
  route --> market
  route --> personal
  personal -->|体检| health["确定性体检<br/>有效前提下计算<br/>缺少前提时提示确认"]
  personal -->|调仓| guide["提示进入调仓计划"]
  guide -.->|用户操作| plan["计划入口确认条件<br/>持仓 · 目标权重 · 换手约束<br/>执行确定性测算"]
  market --> grounded(["依据工具结果组织回答"])
  health --> grounded
  classDef accent fill:#fff1e3,stroke:#e86f00,color:#202124,stroke-width:1.6px
  classDef base fill:#ffffff,stroke:#cbd0d6,color:#30343b
  classDef dark fill:#292d34,stroke:#292d34,color:#ffffff
  classDef notice fill:#fff8ef,stroke:#d7a467,color:#78501b,stroke-dasharray:4 3
  class entry dark
  class route,personal,plan accent
  class confirm notice
  class user,general,profile,saved,market,health,guide,grounded base
