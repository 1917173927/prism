flowchart TB
    FILE["TXT / Markdown / 可提取文本 PDF<br/>上传上限 8 MiB<br/>PDF 页数不超过 1000"] --> TEXT["pypdf 提取页面文本<br/>保留标题、来源、发布时间、主体、期间"]
    TEXT --> CHUNK["按自然段与长度组织片段<br/>长自然段每个片段最多 1200 字符<br/>保存 page、paragraph、text 与 revision"]
    CHUNK --> SCOPE["候选资料范围检查<br/>owner_id / visibility<br/>published_at 不晚于 as_of<br/>片段与当前文档 revision 一致"]
    SCOPE --> KEY["关键词检索<br/>SQLite FTS5 / BM25"]
    SCOPE --> EMB["满足模型与 revision 条件<br/>混合检索启用时<br/>使用 cosine 向量排序"]
    KEY --> RANK["关键词结果或 RRF 融合结果<br/>RRF = Σ 1/(60 + rank)"]
    EMB --> RANK
    RANK --> CITE["返回原文、页码、版本与来源<br/>原始片段 RETRIEVED_UNVERIFIED<br/>分别核对相关性与精确引文"]
    NOTE["混合检索默认关闭<br/>保留候选截断、缺项和版本变化状态<br/>金融声明继续接受来源验证"] -.-> CITE
