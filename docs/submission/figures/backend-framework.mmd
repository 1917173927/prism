flowchart TD
  access(["FastAPI / Uvicorn<br/>HTTP 与 SSE · 用户归属 · Pydantic 校验"]) --> services
  subgraph services[01  应用服务]
    direction LR
    dialogue["对话协调<br/>意图路由 · 工具调用"]
    context["用户上下文<br/>画像 · 持仓 · 会话前提"]
    research["研究执行<br/>专业任务 · DAG 调度"]
