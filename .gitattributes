* text=auto

.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf

*.py text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf

# Frozen evidence hashes identify exact bytes, including original line endings.
eval_cases/research/real_macro_bank_100.json -text whitespace=cr-at-eol
docs/submission/test-evidence/research-quality-20261003/*.json -text whitespace=cr-at-eol
*.ps1 text eol=crlf
*.bat text eol=crlf

*.docx binary
*.pdf binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.exe binary
*.zip binary

# Runtime licenses are hashed as the exact bytes shipped in the Windows demo.
tools/windows_product_demo/*.txt text eol=lf
tools/windows_product_demo/runtime-LICENSE.txt -whitespace conflict-marker-size=128
tools/windows_product_demo/licenses/*.txt text eol=lf
tools/windows_product_demo/licenses/*.md -whitespace conflict-marker-size=128

# Bundled template literals retain significant SVG whitespace; check the source files.
app/api/static/workflow-editor.js -whitespace linguist-generated=true
